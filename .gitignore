# Standards
node_modules
.vite

# Local env files (Vite / Supabase keys). Commit .env.example, never .env.
.env
.env.local

# CJK source font for the factory-test subset (tools/image-convert/gen-cjk-font.sh).
# Only the generated main/apps/font_cjk_generated.c is committed; the multi-MB
# source font is a local build input.
tools/image-convert/*.otf
tools/image-convert/*.ttf
tools/image-convert/*.ttc

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
# Alternate ESP-IDF build directories used for local factory/audit checks.
/build-factory/
/tools/relay_firmware/build-audit/
/tools/sync_station/build-audit/
# Rust (tools/rapid-flash)
**/target/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# VS Code user-local settings
.vscode/settings.json

# Local inspection caches and raw device memory dumps, not deliverables.
/outputs/**/*.inspect.ndjson
/outputs/thumbnail-fix/capture-debug.txt
