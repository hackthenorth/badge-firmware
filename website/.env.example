# Local development environment for badge.hackthenorth.com.
# Copy to .env (gitignored) and fill in real values; Netlify uses the same
# names under Site settings → Environment variables.
VITE_SUPABASE_URL=https://qoouxoeavyuokuscvxff.supabase.co
# Publishable key override for /sync snapshot uploads. The badge-relay
# publishable key is already hardcoded in src/sync/supabase.js, so this is
# only needed to point at a different project. Blank disables uploads.
# VITE_SUPABASE_ANON_KEY=
# Badge writes (local dev enables both; netlify.toml enables production unlock):
# VITE_POST_EVENT_UNLOCK=true
# VITE_POST_EVENT_IDENTITY=true
